// One source of truth for app version, platform and local build identity.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 6
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
PRODUCT_BUNDLE_IDENTIFIER = local.aiusagebar.app
PRODUCT_NAME = AIUsageBar
INFOPLIST_FILE = AIUsageBar/App/Info.plist
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
CODE_SIGN_ENTITLEMENTS = AIUsageBar/App/AIUsageBar.entitlements
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks

// Bridge copies the executable to a stable path, including Debug builds.
ENABLE_DEBUG_DYLIB = NO
